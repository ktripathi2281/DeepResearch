# Copy to .env and adjust. Never commit .env with secrets.
#
# REQUIRED for local default mode (Ollama + Postgres on localhost):
#   DATABASE_URL (below), POSTGRES_* (compose only).
# Everything else has safe local defaults. Cloud keys are OPTIONAL
# and only needed when LLM_PROVIDER selects a cloud adapter.

APP_NAME=deepresearch
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Browser access (local default) ---
# Browser origins allowed to call the research API (comma-separated).
# Empty = no browser origins (API-only mode). "*" is rejected: list
# explicit origins instead.
CORS_ORIGINS=http://localhost:3000

# --- Provider selection (local default) ---
# LLM_PROVIDER=ollama  # or: openai_compatible | gemini
# Optional OpenAI-compatible adapter (key needed only when selected):
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# Optional Gemini adapter (key needed only when selected):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Optional research job retention bound (terminal jobs only; running
# jobs are never evicted):
# RESEARCH_MAX_RETAINED_JOBS=100

# --- Database (required) ---
# Docker Compose default (service name `postgres`):
# DATABASE_URL=postgresql+psycopg://deepresearch:deepresearch@postgres:5432/deepresearch
# Local (host) default:
DATABASE_URL=postgresql+psycopg://deepresearch:deepresearch@localhost:5432/deepresearch
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch
POSTGRES_DB=deepresearch
