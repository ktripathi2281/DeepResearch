# Copy to .env and adjust. Never commit .env with secrets.
APP_NAME=deepresearch
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins allowed to call the research API (comma-separated).
CORS_ORIGINS=http://localhost:3000
# --- M19 provider selection (local-first; cloud is optional) ---
# LLM_PROVIDER=ollama  # or: openai_compatible | gemini
# Optional OpenAI-compatible adapter (needs a key only when selected):
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# Optional Gemini adapter (needs a key only when selected):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Docker Compose default (service name `postgres`):
# DATABASE_URL=postgresql+psycopg://deepresearch:deepresearch@postgres:5432/deepresearch
# Local (host) default:
DATABASE_URL=postgresql+psycopg://deepresearch:deepresearch@localhost:5432/deepresearch
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch
POSTGRES_DB=deepresearch
