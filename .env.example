# Copy to .env and adjust. Never commit .env with secrets.
APP_NAME=deepresearch
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins allowed to call the research API (comma-separated).
CORS_ORIGINS=http://localhost:3000
# Docker Compose default (service name `postgres`):
# DATABASE_URL=postgresql+psycopg://deepresearch:deepresearch@postgres:5432/deepresearch
# Local (host) default:
DATABASE_URL=postgresql+psycopg://deepresearch:deepresearch@localhost:5432/deepresearch
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch
POSTGRES_DB=deepresearch
